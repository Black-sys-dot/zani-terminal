# Copy this file to `.env` in your install/run directory and fill in the keys.
# Zani reads keys from the environment, or from a `.env` file in one of two places:
#   1. the directory where zani is installed, or
#   2. the directory you run zani from.
#
# This example file is safe to commit. Never commit a real `.env`.

# Google Gemini (used when model.provider = "google")
GOOGLE_API_KEY=""

# OpenRouter (used when model.provider = "openrouter")
OPENROUTER_KEY=""
