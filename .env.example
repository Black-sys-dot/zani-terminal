# Copy to `.env` next to the zani install (machine-wide default).
#
# Per project: `zani tui` creates `.zani.env` in that folder if missing — put
# the active provider key there (see config/settings.yaml). Project values
# override install `.env`. The harness never exposes `.zani.env` to the model.
#
# This example file is safe to commit. Never commit a real `.env`.

# Google Gemini (used when model.provider = "google")
GOOGLE_API_KEY=""

# OpenRouter (used when model.provider = "openrouter")
OPENROUTER_KEY=""
